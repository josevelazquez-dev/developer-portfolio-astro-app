---
const personalImageAlt = "José Velázquez"
import Badge from "../components/Badge.astro"
import LinkedInIcon from "../components/icons/LinkedIn.astro"
import MailIcon from "../components/icons/Mail.astro"
import GitHubIcon from "../components/icons/GitHub.astro" 
import SocialPill from "../components/SocialPill.astro"
---

<div class="max-w-xl md:max-w-2xl -mt-10 md:-mt-20 transition-all duration-300">
  <div class="flex gap-6 mb-6 items-center mt-8">
    <img
      class="rounded-full shadow-lg size-16 object-cover"
      src="/jose.webp"
      alt={personalImageAlt}
    />

    <a
      href="https://www.linkedin.com/in/josevelazquez-dev/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:hover:scale-105"
    >
      <Badge>
        Disponible para trabajar
      </Badge>
    </a>
  </div>

  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hola, soy José Velázquez
  </h1>

  <div class="mt-4 text-base md:text-lg text-gray-800 dark:text-gray-300 space-y-3 leading-relaxed">
    <p>
      Licenciado en Ingeniería en Sistemas Computacionales con área terminal
      en administración de redes y diseño de plataformas web.
    </p>

    <p>
      Cuento con experiencia trabajando con
      JavaScript, React, Astro, Tailwind CSS, Node.js, Express, Next.js,
      React Native y Firebase. Mi enfoque se centra en crear aplicaciones
      funcionales, escalables y optimizadas.
    </p>

    <p>
      Actualmente busco integrarme a equipos de tecnología donde pueda aportar mis conocimientos y continuar mi crecimiento profesional.
    </p>
  </div>

  <nav class="flex flex-wrap gap-4 mt-6">
    <SocialPill href="mailto:josevelazquezolvera2@gmail.com">
      <MailIcon class="size-4" />
      josevelazquezolvera2@gmail.com
    </SocialPill>

    <SocialPill href="https://www.linkedin.com/in/josevelazquez-dev/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>

    <SocialPill href="https://github.com/josevelazquez-dev">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>