---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Html from "./icons/Html.astro"
import Css from "./icons/Css.astro"
import JavaScript from "./icons/JavaScript.astro"
import React from "./icons/React.astro"

const TAGS = {
  HTML: {
    name: "HTML",
    class: "bg-[#003159] text-white",
    icon: Html,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#003159] text-white",
    icon: Css,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-[#003159] text-white",
    icon: JavaScript,
  },
  REACT: {
    name: "React",
    class: "bg-[#003159] text-white",
    icon: React,
  },
}

const PROJECTS = [
  {
  title: "Juego de Serpiente",
  description: 
    "Recreación del icónico juego arcade utilizando lógica de programación pura en JavaScript. Implementa gestión de estados para el movimiento de la serpiente, detección de colisiones mediante coordenadas en un entorno 2D y un sistema de renderizado dinámico. El proyecto destaca por el uso de estructuras de datos para el cuerpo de la serpiente y una interfaz responsiva que adapta la velocidad según el puntaje del usuario.",
  link: "https://snake-game-sigma-seven.vercel.app/",
  github: "https://github.com/josevelazquez-dev/snake-game-javascript-app",
  image: "/projects/serpiente.webp",
  tags: [TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT],
},

  {
  title: "Aplicación de Tareas",
  description: 
    "Gestor de productividad desarrollado con React, centrado en una experiencia de usuario fluida mediante la manipulación eficiente del estado y componentes reutilizables. Implementa persistencia de datos en LocalStorage, filtrado dinámico de tareas y una arquitectura basada en hooks (useState, useEffect) para garantizar una interfaz reactiva, moderna y totalmente adaptable.",
  link: "https://task-manager-pro-app.vercel.app/",
  github: "https://github.com/josevelazquez-dev/task-manager-react-app",
  image: "/projects/task-manager.webp", // Asegúrate de que la ruta sea correcta
  tags: [TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT, TAGS.REACT],
},

  {
    title: "Contador de Clics",
    description: `Aplicación web interactiva desarrollada con JavaScript puro que permite registrar clics en tiempo real mediante una interfaz sencilla y dinámica. Cada interacción actualiza automáticamente el contador en pantalla, destacando el manejo del DOM, eventos y lógica de estado en el frontend.`,
    link: "https://click-counter-web.vercel.app/",
    github: "https://github.com/josevelazquez-dev/click-counter-vanilla-app.git",
    image: "/projects/click-counter.webp",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT],
  },

  {
    title: "Calculadora Web",
    description: `Aplicación web desarrollada con JavaScript que permite realizar operaciones matemáticas básicas como suma, resta, multiplicación y división a través de una interfaz intuitiva y responsive. Destaca por la implementación de lógica de cálculo, manejo de eventos y manipulación del DOM para ofrecer una experiencia de usuario fluida.`,
    link: "https://react-calc-pro.vercel.app/",
    github: "https://github.com/josevelazquez-dev/calculator-react-app.git",
    image: "/projects/react-calculator-pro.webp",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 border-b border-gray-300 dark:border-gray-600 pb-8 last:border-b-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt={`Captura de pantalla del proyecto ${title}`}
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>

          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>

            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}

              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>